{
  "name": "@erp/admin",
  "version": "1.0.0",
  "description": "School ERP Admin App (management surface).",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node ./scripts/start.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "android:local": "expo run:android",
    "android:device": "expo run:android --device",
    "logs:android": "powershell -ExecutionPolicy Bypass -File ./scripts/capture-launch-logs.ps1",
    "icons:pad": "node ./scripts/pad-app-icons.mjs",
    "update:preview": "eas update --channel preview --message",
    "update:production": "eas update --channel production --message"
  },
  "dependencies": {
    "@erp/core": "*",
    "@erp/ui": "*",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.10.3",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/stack": "^7.3.3",
    "@tanstack/query-async-storage-persister": "^5.62.8",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-query-persist-client": "^5.62.8",
    "axios": "^1.6.5",
    "expo": "^58.0.0-preview.4",
    "expo-auth-session": "~58.0.3",
    "expo-blur": "~58.0.1",
    "expo-constants": "~58.0.4",
    "expo-crypto": "~58.0.2",
    "expo-device": "~58.0.1",
    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-image-picker": "~58.0.4",
    "expo-linear-gradient": "~58.0.1",
    "expo-local-authentication": "~58.0.0",
    "expo-location": "~58.0.4",
    "expo-notifications": "~58.0.4",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.7",
    "expo-status-bar": "~58.0.1",
    "expo-updates": "~58.0.6",
    "expo-web-browser": "~58.0.1",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~58.0.4",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": ["../../node_modules", "node_modules"]
    }
  }
}
