{
  "name": "school-erp-mobile",
  "version": "1.0.0",
  "description": "School ERP mobile monorepo — Admin and Users Android apps, combined iOS app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start:users",
    "start:admin": "npm start --workspace=@erp/admin",
    "start:users": "npm start --workspace=@erp/users",
    "start:ios": "npm start --workspace=@erp/ios",
    "start:edulynk": "npm start --workspace=@erp/edulynk",
    "android:edulynk": "npm run android --workspace=@erp/edulynk",
    "android:admin": "npm run android --workspace=@erp/admin",
    "android:users": "npm run android --workspace=@erp/users",
    "ios:admin": "npm run ios --workspace=@erp/admin",
    "ios:users": "npm run ios --workspace=@erp/users",
    "ios:combined": "npm start --workspace=@erp/ios",
    "test": "jest --config jest.config.js",
    "test:design-system": "jest --config jest.config.js packages/ui/src/__tests__",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.10.3",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/stack": "^7.3.3",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "expo": "^58.0.0-preview.4",
    "expo-auth-session": "~58.0.3",
    "expo-build-properties": "~58.0.4",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.4",
    "expo-device": "~58.0.1",
    "expo-document-picker": "~58.0.0",
    "expo-font": "~58.0.2",
    "expo-image-picker": "~58.0.4",
    "expo-linear-gradient": "~58.0.1",
    "expo-local-authentication": "~58.0.0",
    "expo-location": "~58.0.4",
    "expo-notifications": "~58.0.4",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.1",
    "expo-updates": "~58.0.6",
    "expo-web-browser": "~58.0.1",
    "react": "19.3.0",
    "react-hook-form": "^7.49.3",
    "react-native": "0.88.0-rc.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-dotenv": "^3.4.10",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-paper": "^5.11.3",
    "react-native-pdf": "^6.7.4",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-sms-retriever": "^1.1.1",
    "react-native-svg": "15.15.5",
    "react-native-vector-icons": "^10.0.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.2",
    "semver": "^7.8.2",
    "webidl-conversions": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.23.8",
    "@babel/runtime": "^7.23.8",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~58.0.4",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro": "^0.84.4",
    "metro-runtime": "^0.84.4",
    "prettier": "^3.1.1",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
